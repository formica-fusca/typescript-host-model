{
  "name": "typescript-host-model",

  // A base image plus the Node feature, rather than a `javascript-node:24`
  // image. That keeps ONE source of truth for the Node version, pinned to the
  // exact patch every result in this course was verified against. A floating
  // tag like `:24` would drift within 24.x without this file changing — the
  // same failure mode the course describes for `"target": "esnext"`.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24.18.0" }
  },

  // Two workspaces, two lockfiles, on purpose: the docs app and the case study
  // pin different TypeScript versions. `npm ci` rather than `npm install` so a
  // drifted lockfile fails here too.
  "postCreateCommand": "npm ci && npm --prefix case-study ci",

  // `postCreateCommand` runs ONCE, when a container is created. Cloud IDEs
  // optimise by cloning and resuming containers instead of creating them — a
  // CodeSandbox fork inherits the parent's filesystem, so create-time setup
  // never re-runs and a partial install propagates. This guard runs on every
  // start and is a no-op when the install is intact.
  //
  // It checks for `@typescript/`, not `node_modules/`: TypeScript 7 splits into
  // a Node shim (`.bin/tsc`) plus a per-platform native binary, and the failure
  // actually observed was the shim present and every binary missing.
  "postStartCommand": "test -d case-study/node_modules/@typescript || npm --prefix case-study ci",

  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode"]
    }
  }
}
